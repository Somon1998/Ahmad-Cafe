# =============================================================================
# Taste Street — переменные окружения
#
# Локально:
#   Windows:  copy .env.example .env.local
#   macOS/Linux:  cp .env.example .env.local
#
# Заполните .env.local реальными значениями. Файл .env.local не коммитьте в git.
# После изменения .env.local перезапустите: npm run dev
# =============================================================================

# --- Supabase (обязательно для меню и админки) ---
# Supabase Dashboard → ваш проект → Project Settings (шестерёнка) → API
#
# NEXT_PUBLIC_SUPABASE_URL  ←  поле «Project URL»
#   Пример: https://abcdefghijklmnop.supabase.co
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY  ←  «Project API keys» → «anon» → «public»
#   Длинный JWT (начинается с eyJ...). Это публичный ключ для браузера.
#
# НЕ используйте service_role — он только для сервера и опасен во фронтенде.
#
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Сайт (опционально, есть значения по умолчанию) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp: только цифры, код страны без + (опционально) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=992939999029
